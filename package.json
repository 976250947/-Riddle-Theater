{
  "name": "riddle-theatre",
  "version": "0.2.0",
  "private": true,
  "description": "Vue + Express + Prisma architecture for the Riddle Theatre interactive narrative platform.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:web": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "start": "npm run dev",
    "test": "node scripts/test.js",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
