# Copy this file to frontend/.env.local and fill in your real key.
VITE_LLM_ENABLED=true
VITE_LLM_BASE_URL=https://api.deepseek.com
VITE_LLM_MODEL=deepseek-chat
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key
VITE_LLM_TIMEOUT=30000
VITE_LLM_TEMPERATURE=0.85
VITE_LLM_MAX_TOKENS=800
VITE_LLM_STREAM=false
